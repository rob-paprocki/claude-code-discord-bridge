{
  "name": "claude-code-discord-bridge-worker",
  "private": true,
  "cloudflare": {
    "bindings": {
      "DISCORD_BOT_TOKEN": {
        "description": "Your Discord bot's token: Discord Developer Portal → your application → Bot → Reset Token."
      }
    }
  },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261109.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0"
  }
}
